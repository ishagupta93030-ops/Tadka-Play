# Copy this file to server/.env for local development.
# Never commit a real .env file. Do not put production secrets here.

# --- Backend (required in production) ---
NODE_ENV=development
PORT=5000

# Generate a long random value (32+ characters). Never reuse the example string.
JWT_SECRET=replace_with_a_long_random_secret

# Frontend origin(s) allowed by CORS. Comma-separated, no trailing slash.
# Local Vite: http://localhost:3000
# Production example: https://your-frontend.example.com
CLIENT_ORIGIN=http://localhost:3000

# Serve the React build from Express (true when client/dist exists). Set false for API-only hosts.
SERVE_CLIENT=true

# --- Database ---
# Set DB_DRIVER=mongodb after migrating. MongoDB transactions require Atlas or a replica set.
DB_DRIVER=mysql
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB=tadkaplay_db

# --- MySQL (legacy/source migration) ---
# Option A: individual fields
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=tadkaplay_db

# Option B: single URL (overrides Option A when set)
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DB_NAME

# Managed MySQL (Aiven, PlanetScale, Railway, RDS) usually needs SSL
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_SIZE=10

# Optional: first admin created by `npm run seed` in server/
ADMIN_EMAIL=admin@tadkaplay.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password

VIRTUAL_COINS_ONLY=true
