# Copy to client/.env or client/.env.production as needed.
# Vite inlines VITE_* variables at BUILD time, not at runtime.

# Leave empty when the API is on the same origin (Express serving client/dist).
# When the frontend is hosted separately, set the public API origin (no trailing slash):
# VITE_API_URL=https://your-api.example.com
VITE_API_URL=
